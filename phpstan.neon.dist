includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - config
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    # Bu bir paket; config/ dizini uygulamanın config path'i olarak
    # görülmediği için larastan env() çağrılarını yanlış işaretliyor.
    noEnvCallsOutsideOfConfig: false
