{
    "name": "voxyfy/anadolupay",
    "description": "Türk banka sanal POS'ları ve ödeme kuruluşları için birleşik Laravel ödeme geçidi — NestPay, Garanti, PosNet, PayFlex, PayFor, InterPos, KuveytPos, PayTR, Param.",
    "keywords": [
        "voxyfy",
        "laravel",
        "anadolupay",
        "payment",
        "gateway",
        "turkey",
        "turkish"
    ],
    "homepage": "https://github.com/Voxyfy/anadolupay",
    "license": "MIT",
    "authors": [
        {
            "name": "Voxyfy",
            "email": "info@voxyfy.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "psr/log": "^2.0|^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.30",
        "nunomaduro/collision": "^8.8",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Voxyfy\\AnadoluPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Voxyfy\\AnadoluPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Voxyfy\\AnadoluPay\\AnadoluPayServiceProvider"
            ],
            "aliases": {
                "AnadoluPay": "Voxyfy\\AnadoluPay\\Facades\\AnadoluPay"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
